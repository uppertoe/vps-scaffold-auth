# End-to-end test sites. Each site exercises one guard from deploy/auth.caddy,
# which is mounted unchanged, so the test proves the snippets this repository
# ships. Keep comments free of braces: the scaffold counts them.
{
	admin off
	local_certs
	skip_install_trust
	auto_https disable_redirects
}

import /etc/caddy/auth.caddy

# Staff: the User role of the e2e-app app, which the test gives to a domain
# group. Also sets an app cookie of its own, so the test can prove that the
# gateway's renewed cookie is ADDED beside it, not swapped.
app.{$DOMAIN} {
	header +Set-Cookie "app_own=set-by-app; Path=/"
	import role "e2e-app" "user" whoami:80
}

# The one app open to the public: its User role is given to guests.
open.{$DOMAIN} {
	import role "e2e-open" "user" whoami:80
}

# Members of a list.
reports.{$DOMAIN} {
	import role "e2e-reports" "user" whoami:80
}

# A role guard: the Manager role of the e2e app, which the test gives to one
# person through the admin pages.
roles.{$DOMAIN} {
	import role "e2e" "manager" whoami:80
}

# A role guard for a role that nobody holds.
editors.{$DOMAIN} {
	import role "e2e" "editor" whoami:80
}

# The role gate for a site with no upstream: a static file_server, gated by
# the Manager role. The Caddy image ships its own index page to serve.
static.{$DOMAIN} {
	import role_gate "e2e" "manager"
	root * /usr/share/caddy
	file_server
}

# The role gate for a site that only redirects, by the Manager role.
go.{$DOMAIN} {
	import role_redir "e2e" "manager" "https://example.org{uri}"
}

# A hand-rolled guard with a misspelt header: it names no app, so the
# gateway refuses it. It must close, not open.
broken.{$DOMAIN} {
	route {
		import strip_client_identity
		reverse_proxy auth:8080 {
			method GET
			rewrite /verify
			header_up X-Forwarded-Method {method}
			header_up X-Forwarded-Uri {uri}
			header_up X-Auth-Ap "e2e-app"
			@allowed status 2xx
			handle_response @allowed {
				request_header Remote-User {http.reverse_proxy.header.Remote-User}
			}
		}
		reverse_proxy whoami:80 {
			import strip_auth_cookie
		}
	}
}

# A wholly public app: no guard, but the session cookie and any forged
# identity headers must still be removed.
public.{$DOMAIN} {
	reverse_proxy whoami:80 {
		import strip_public
	}
}

# Public and protected paths on one host.
mixed.{$DOMAIN} {
	@public path /webhooks/*
	handle @public {
		reverse_proxy whoami:80 {
			import strip_public
		}
	}
	handle {
		import role "e2e-app" "user" whoami:80
	}
}
