# Public login endpoints. No auth in front of these -- this IS the login.
# Overwrite X-Forwarded-For with the true peer address so a client cannot spoof
# it: the auth service rate-limits per client IP, and Caddy otherwise preserves
# any inbound X-Forwarded-For (appending the real peer), which a leftmost reader
# would trust. Caddy faces clients directly here, so the remote host is the client.
auth.{$DOMAIN} {
	# The break-glass token rides in the URL path (/break/<token>), and so does
	# an invitation's (/invite/<token>). Keep those requests out of the access
	# log so neither credential is ever written to disk / shipped off-host.
	# (Browser history still holds them -- that is inherent to a link or a
	# scannable card; this closes the server-side log exposure.)
	@breakglass path /break /break/* /invite/*
	log_skip @breakglass

	reverse_proxy auth:8080 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# Reusable access guards, by app role. A protected app adds ONE import line,
# naming its app and the role the path needs; the LAST argument of the role
# guard is the app's upstream address. The guard asks the gateway at /verify
# and then reverse_proxies to that upstream with the shared session cookie
# stripped (see strip_auth_cookie), so an app needs no separate reverse_proxy
# line. On an unauthenticated request /verify returns a 302 to the login page;
# on a session that holds the role it returns 200 and Caddy forwards
# Remote-User / Remote-Email / Remote-Roles upstream. Each guard
# deletes any client-supplied Remote-* and rule headers up front (import
# strip_client_identity), so the app can never see a spoofed identity header.
# A person who is signed in but holds no role in THIS app is sent to a
# friendly "no access" page with a sign-in link -- never bounced back to login.
#
# NOTE: keep comments in .caddy files free of braces -- the scaffold's
# run-caddy.sh counts braces when assembling the Caddyfile.
#
# Usage (UPSTREAM is host:port):
#   import role "enquiries" "admin" UPSTREAM        -- a person who holds that role in that app,
#                                                      as the app roles admin pages assign it.
#                                                      Use "user" for the app's ordinary role,
#                                                      which any role in the app also admits.
#                                                      The app also receives Remote-Roles.
#   import role_gate "handbook" "user"              -- the role form for a site with no upstream,
#                                                      such as a static file_server: import it at
#                                                      the top of the site block, then write the
#                                                      block's own root and file_server.
#   import role_redir "numbers" "user" "https://example.org"
#                                                   -- the role form for a site that only redirects.
#
# For a per-route entrance, put the import inside a handle block (the upstream
# argument still rides on the import), e.g. an /admin door for the app's admin
# role beside its user role on the same host -- see "Per-app access" in the
# README.
#
# The app and role must be declared in the gateway's app roles manifest
# (APP_ROLES_FILE), and the guard's host must be one of the app's hosts there,
# or every request is refused. A guard that names no app is refused too: every
# signed-in person is sent to the "no access" page. Always use these snippets
# rather than hand-rolling forward_auth.
#
# The role guard's gate is the expanded form of Caddy's forward_auth (method
# GET, rewrite to /verify, the two X-Forwarded-* headers and the Remote-* copy
# on a 2xx) with one addition forward_auth cannot express: when /verify answers
# 2xx AND sets a renewed session cookie, that Set-Cookie is added to the
# response the browser receives. forward_auth's copy_headers only copies into
# the upstream request, so a sliding renewal issued at /verify would never reach
# the browser and every session would simply run out at its original expiry.
# Only the gateway's own cookie is forwarded (matched by name), and it is ADDED,
# so an app's own Set-Cookie survives. The renewed branch is listed first
# because the first matching handle_response wins.

# The gate for a role guard: it names the app and the role in X-Auth-App and
# X-Auth-Role, and copies Remote-Roles, the roles the person holds in the app,
# to the upstream. Args: app, role.
(auth_gate_role) {
	reverse_proxy auth:8080 {
		method GET
		rewrite /verify
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Auth-App "{args[0]}"
		header_up X-Auth-Role "{args[1]}"
		@renewed {
			status 2xx
			header Set-Cookie vps_auth_session=*
		}
		handle_response @renewed {
			request_header Remote-User {http.reverse_proxy.header.Remote-User}
			request_header Remote-Email {http.reverse_proxy.header.Remote-Email}
			request_header Remote-Roles {http.reverse_proxy.header.Remote-Roles}
			header +Set-Cookie {http.reverse_proxy.header.Set-Cookie}
		}
		@allowed status 2xx
		handle_response @allowed {
			request_header Remote-User {http.reverse_proxy.header.Remote-User}
			request_header Remote-Email {http.reverse_proxy.header.Remote-Email}
			request_header Remote-Roles {http.reverse_proxy.header.Remote-Roles}
		}
	}
}

# A person who holds a role in an app. Args: app, role, upstream, e.g.
#   import role "enquiries" "admin" fellows:8080
# The app and role must be declared in the gateway's app roles manifest, or
# every request is refused. The guard deletes the client's copies of every
# identity and rule header first, Remote-Roles and the role headers included,
# so the app sees only the gateway's answer.
(role) {
	route {
		import strip_client_identity
		request_header -Remote-Roles
		request_header -X-Auth-App
		request_header -X-Auth-Role
		import auth_gate_role "{args[0]}" "{args[1]}"
		reverse_proxy {args[2]} {
			import strip_auth_cookie
		}
	}
}

# Gate NON-PROXIED content, such as a static file_server site, by an app role.
# Args: app, role. Import it at the top of the site block, then write the
# block's own root and file_server as usual: in Caddy's default directive
# order file_server runs near-last, after this gate's route. Do NOT pair it
# with a top-level redir, which orders BEFORE the gate; use role_redir for
# that.
#   import role_gate "handbook" "user"
# The app and role must be declared in the gateway's app roles manifest, as
# for the role guard, and the gate deletes the same client headers first.
# Gated responses default to Cache-Control "private, no-cache" (?-prefixed, so
# a site block can override): the gate decides the fetch, not the copy, and
# without this a browser on a shared workstation can serve gated pages from
# its cache after sign-out. no-cache forces revalidation, which re-enters this
# gate; private keeps shared caches out. Fingerprinted static assets, with a
# content hash in the file name, are left to the scaffold's immutable-cache
# rule: they carry no per-user content. The regex matches the renderer's
# hashed-asset rule, Hugo's processed-image names included.
(role_gate) {
	route {
		import strip_client_identity
		request_header -Remote-Roles
		request_header -X-Auth-App
		request_header -X-Auth-Role
		import auth_gate_role "{args[0]}" "{args[1]}"
		@uncacheable not path_regexp (?:\.[0-9a-f]{8,}|_hu_[0-9a-f]{12,16})\.(?:css|js|mjs|woff2?|ttf|otf|svg|png|jpe?g|webp|avif|gif|ico)$
		header @uncacheable ?Cache-Control "private, no-cache"
	}
}

# Gate a REDIRECT, with no upstream, by an app role: for a vanity name that
# sends people on to a site with no sign-in of its own. Args: app, role,
# target URL, which may carry a trailing uri placeholder to keep the path.
#   import role_redir "numbers" "user" "https://example.org"
# The route wrapper is load-bearing: in Caddy's default directive order a bare
# redir runs BEFORE the gate, which would skip it entirely. The redirect is
# deliberately 302, because browsers cache a 301 and would bypass the gate on
# every later visit.
(role_redir) {
	route {
		import strip_client_identity
		request_header -Remote-Roles
		request_header -X-Auth-App
		request_header -X-Auth-Role
		import auth_gate_role "{args[0]}" "{args[1]}"
		redir {args[2]}
	}
}

# Strip the shared session cookie before the request reaches an app backend. The
# session cookie is scoped to .<domain>, so the browser sends it to every
# subdomain, and forward_auth proxies the original request (cookies included)
# upstream. Without this strip, every protected app backend would receive a live,
# estate-wide bearer credential it doesn't need, and a single compromised or
# malicious app could replay it against every other app as that user (there is no
# per-session revocation to stop it). Apps must take identity ONLY from the
# Remote-* headers -- which forward_auth sets and Caddy strips from client input
# -- never from the cookie. The guards above import this automatically; it is
# also exposed for a hand-rolled reverse_proxy. It removes only vps_auth_session,
# leaving the app's own cookies intact.
(strip_auth_cookie) {
	header_up Cookie "(^|;\s*)vps_auth_session=[^;]*" ""
}

# For a PUBLIC route: import inside its reverse_proxy, in place of
# strip_auth_cookie. A public route has no guard, so nothing else removes the
# identity headers a client sends, and an app that reads Remote-User anywhere
# (a mixed host whose webhook path shares the app's middleware) would believe a
# forged identity there. This removes the session cookie and every Remote-*
# header. Never use it inside a guard: there the Remote-* headers are the
# gateway's own and must reach the app. Proven by e2e/chain_test.go.
(strip_public) {
	header_up Cookie "(^|;\s*)vps_auth_session=[^;]*" ""
	header_up -Remote-User
	header_up -Remote-Email
	header_up -Remote-Groups
	header_up -Remote-Roles
}

# Delete any client-supplied identity headers from the request BEFORE forward_auth
# runs, so its copy_headers can re-add the authoritative values on a 2xx. The apps
# trust Remote-* because only Caddy sets them; this makes that guarantee explicit
# rather than relying solely on copy_headers' overwrite-on-2xx (which leaves a
# theoretical gap on non-2xx and is easy to misread). It MUST be imported inside a
# route block (as the guards above do) so it runs before forward_auth: Caddy's default
# directive order otherwise places a bare request_header AFTER forward_auth, which
# would delete the authoritative value instead. Verified against Caddy 2 with a
# live forward_auth + whoami harness.
(strip_client_identity) {
	request_header -Remote-User
	request_header -Remote-Email
	request_header -Remote-Groups
	# The gateway never sends Remote-Name, but another sign-in service such as
	# Authelia does, and an app behind it may read it: a client must not be
	# able to send one past a guard either.
	request_header -Remote-Name
	# Every guard strips a client-sent Remote-Roles too, not only the role
	# guard: an app that reads Remote-Roles must never believe one a client
	# sent through an older guard.
	request_header -Remote-Roles
}
