# vps-scaffold-auth configuration.
# Copy to apps/auth/.env in your server repo and fill in. Never commit the real
# .env — the deploy helper sets it to mode 600 on the server.

# --- Identity / authorization ---
# Public base URL of the auth service (the auth.<domain> site).
AUTH_PUBLIC_URL=https://auth.myserver.example.com
# Comma-separated domains whose verified email holders become regular users.
# Use "*" for OPEN REGISTRATION: any email verified by a one-time code becomes a
# user (for a public service). With "*", a plain `import protected` app admits
# anyone signed in, so gate private apps by group or domain instead.
ALLOWED_EMAIL_DOMAINS=example.com,example.org
# Optional: hosts (DOMAIN or a subdomain of it) where strangers may sign in as
# guests. A guest reaches only apps guarded by `import protected_open`; every
# other app stays closed to them. Prefer this to "*" on a shared server.
# OPEN_REGISTRATION_HOSTS=apply.example.com
# Comma-separated explicit admin emails (granted the "admin" group).
ADMIN_EMAILS=alice@example.com
# Optional "Continue" link shown on the signed-in page when a user logs in
# without a specific app target (e.g. a direct visit to the login page). Such
# logins now land on the auth host's own signed-in page (which always has a valid
# cert); they are NOT auto-redirected here. Must be a served SUBDOMAIN URL — a
# bare apex (https://myserver.example.com) is ignored, since the gateway serves
# subdomains and the apex often has no certificate.
DEFAULT_REDIRECT=https://app.myserver.example.com

# Allow the bare apex as a post-login destination (default false). Enable when
# the apex is a real site behind this gateway — e.g. a gated path on the
# landing page — so sign-ins from there return to it instead of the welcome
# page. Leave off for subdomain-only deployments where the apex has no cert.
# ALLOW_APEX_REDIRECT=true

# --- Session ---
# 32+ random bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Leading-dot domain so the session is shared across app subdomains.
# IMPORTANT: if DOMAIN is itself a subdomain (vps1.example.com), set this to
# .vps1.example.com — never widen it to a domain you don't fully control.
COOKIE_DOMAIN=.myserver.example.com
SESSION_TTL=2h
# How long before a session slides (renews + re-checks policy/groups). Must be
# less than SESSION_TTL, or a session expires before it can ever renew.
SESSION_RENEW_AFTER=1h
# Lifetime when the user ticks "Keep me signed in" (must be >= SESSION_TTL).
SESSION_REMEMBER_TTL=24h

# --- At-rest secret encryption ---
# Reversible secrets (break-glass tokens, admin TOTP seeds) are encrypted in the
# SQLite file with AES-256-GCM. By default the key is derived from SESSION_SECRET.
# Set a dedicated 32-byte hex key (openssl rand -hex 32) to decouple encryption
# from session signing, so rotating SESSION_SECRET does not require re-encrypting
# stored secrets.
# WARNING: if you leave this unset (key derived from SESSION_SECRET), rotating
# SESSION_SECRET will make all stored TOTP seeds and break-glass tokens
# undecryptable. Set an explicit DATA_ENCRYPTION_KEY in production before you
# have secrets worth keeping, so the two keys rotate independently.
# DATA_ENCRYPTION_KEY=

# --- One-time code ---
OTP_TTL=10m
# Digits in the emailed code (6 to 10). Each extra digit makes online guessing
# ten times harder; 8 is recommended where codes are typed from an email.
OTP_LENGTH=8
OTP_MAX_ATTEMPTS=5
# Wrong guesses allowed at one code across every source IP (the cap above is per
# IP). Reaching it deletes the code; the person requests a fresh one. Default is
# ten times OTP_MAX_ATTEMPTS; must be at least OTP_MAX_ATTEMPTS. A low value
# bounds guessing against one address, at the cost that two source IPs can burn
# a person's live code and make them request another: 10 is recommended.
OTP_MAX_TOTAL_ATTEMPTS=10
# Re-requesting a code within this window is a no-op: the live code is kept and no
# second email is sent (blocks resend spam / attempt-cap reset). Must be < OTP_TTL.
OTP_RESEND_COOLDOWN=60s

# --- Email delivery ---
# smtp | resend | log. The `log` backend prints OTP codes to the process log and
# is DEV-ONLY: the service refuses to boot with EMAIL_BACKEND=log unless
# COOKIE_INSECURE=true, so a production box can never silently leak codes to logs.
EMAIL_BACKEND=smtp
EMAIL_FROM=Login <auth@example.com>
# Product/site name shown as the wordmark in the sign-in code email. Optional;
# defaults to DOMAIN. The email's accent colour comes from the admin branding
# page (/admin/branding), so it matches the login page. Also substituted into
# OTP_EMAIL_SUBJECT via {brand}.
BRAND_NAME=
# Subject line of the sign-in code email. Optional; defaults to
# "{code} is your sign-in code", which leads with the code so it shows in the
# inbox list / notification preview (and is offered to one-time-code autofill)
# without opening the mail. {code} and {brand} are substituted at send time; a
# branded subject with no {code} (e.g. "Login - {brand}") trades that
# inbox-preview affordance for branding.
OTP_EMAIL_SUBJECT=
# smtp backend. TLS is mandatory: port 465 uses implicit TLS, every other port
# (587/25) requires STARTTLS and the send is refused if the relay does not offer
# it (no silent cleartext fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# resend backend
RESEND_API_KEY=

# --- Admin two-factor (optional) ---
# When true, admins must enter an authenticator code after the email step.
# Secrets are admin-provisioned, never self-enrolled: bootstrap the first admin
# with `docker compose exec auth /app -totp-enroll you@example.com`, then manage
# the rest from /admin/totp. An admin with no secret is denied at login.
TOTP_ENABLED=false
TOTP_ISSUER=myserver.example.com

# --- Break-the-glass QR codes ---
# Lifetime for a session granted by scanning a break-glass card. These sessions
# are never renewed; they expire at this absolute timeout. This is the default;
# it can also be set at runtime on the admin Settings page.
BREAKGLASS_SESSION_TTL=8h
# Where to send a user after a break-glass grant (defaults to DEFAULT_REDIRECT).
# BREAKGLASS_REDIRECT=https://app.myserver.example.com
# Admins emailed on each use (defaults to ADMIN_EMAILS). Also editable at runtime
# on the admin Settings page. Set empty to disable.
# BREAKGLASS_NOTIFY_EMAILS=oncall@example.com
# Optional webhook POSTed (JSON) on each use, e.g. an ntfy/Slack/Pushover URL.
# Also editable at runtime on the admin Settings page.
# BREAKGLASS_WEBHOOK_URL=
BREAKGLASS_WEBHOOK_TIMEOUT=5s
# Header/body text printed on the QR card PDF (per-code note adds to the body).
BREAKGLASS_PDF_HEADER=Emergency access
BREAKGLASS_PDF_BODY=Scan this code to gain temporary emergency access. Every use is logged and an administrator is notified.

# --- Rate limiting (count/window) ---
# Codes sent to one address from one client IP, so a stranger elsewhere cannot
# spend the owner's allowance and lock them out.
RATELIMIT_PER_EMAIL=5/15m
# Codes sent to one address from all IPs together: bounds a flood of one inbox
# spread across many IPs.
RATELIMIT_PER_EMAIL_CEILING=12/1h
# Codes one client IP can cause across all addresses: bounds bounce-driven
# damage to the mail account. An address that signed in successfully from the
# same IP within 30 days passes this and the ceiling above, so a flood cannot
# lock an owner out of their usual network.
RATELIMIT_SENDS_PER_IP=60/1h
# Code requests (/request) per client IP. Keep it generous enough that many
# distinct users behind one shared egress IP (a hospital/office NAT) aren't
# throttled.
RATELIMIT_PER_IP=60/15m
# WRONG email or authenticator codes per client IP. A correct code is refunded,
# so people signing in successfully behind one NAT never use it up; the
# per-code attempt cap still bounds guessing against any one address.
RATELIMIT_WRONG_CODES_PER_IP=60/15m
# Break-glass QR scans get their own, more permissive per-IP limit: the 128-bit
# token is the brute-force boundary, so this only limits abuse and must not
# throttle co-located staff scanning during an emergency.
RATELIMIT_BREAKGLASS_PER_IP=60/5m

# --- Audit log ---
# How long login-attempt and app-access audit rows are kept before being pruned.
# App access is deduplicated to one row per user/app/hour, so volume stays low.
# Set to 0 to keep forever.
AUDIT_RETENTION=8760h

# --- Storage / runtime ---
SQLITE_PATH=/data/auth.db
LISTEN_ADDR=:8080
# COOKIE_INSECURE=true        # dev only: drop the Secure cookie attribute when not behind TLS
# IANA timezone for rendering timestamps in the admin UI (access log, audit,
# break-glass cards). Empty = UTC. The zoneinfo DB is embedded in the binary, so
# any IANA name works on the distroless image. Example: Australia/Melbourne.
# DISPLAY_TIMEZONE=

# Optional: an extra instruction line shown on the sign-in page (plain text).
# LOGIN_NOTICE=
