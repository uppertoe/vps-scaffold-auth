# Caddy config for the standalone example. {$DOMAIN} comes from the environment.
{
	# Uncomment and set a contact address for Let's Encrypt:
	# email you@example.com
}

# The guards below are copied from deploy/auth.caddy; see the comments there
# and the README for the whole catalogue. A protected site imports ONE guard,
# naming its app and role, which must be declared in app-roles.tsv; the LAST
# argument is the app's upstream address.
#
#   import role "demo" "user" whoami:80
#
# Some routes need no login at all (a webhook receiver, a health check, a public
# landing page). Give those a plain reverse_proxy with strip_public, and let a
# fallback handle protect the rest:
#
#   app.{$DOMAIN} {
#       @public path /webhooks/* /healthz
#       handle @public {
#           reverse_proxy app:3000 {
#               import strip_public
#           }
#       }
#       handle {
#           import role "app" "user" app:3000
#       }
#   }

# The gate for a role guard: it names the app and the role in X-Auth-App and
# X-Auth-Role, and copies Remote-Roles, the roles the person holds in the app,
# to the upstream. Remote-Groups is still copied until no app reads it.
# Args: app, role.
(auth_gate_role) {
	reverse_proxy auth:8080 {
		method GET
		rewrite /verify
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Auth-App "{args[0]}"
		header_up X-Auth-Role "{args[1]}"
		@renewed {
			status 2xx
			header Set-Cookie vps_auth_session=*
		}
		handle_response @renewed {
			request_header Remote-User {http.reverse_proxy.header.Remote-User}
			request_header Remote-Email {http.reverse_proxy.header.Remote-Email}
			request_header Remote-Groups {http.reverse_proxy.header.Remote-Groups}
			request_header Remote-Roles {http.reverse_proxy.header.Remote-Roles}
			header +Set-Cookie {http.reverse_proxy.header.Set-Cookie}
		}
		@allowed status 2xx
		handle_response @allowed {
			request_header Remote-User {http.reverse_proxy.header.Remote-User}
			request_header Remote-Email {http.reverse_proxy.header.Remote-Email}
			request_header Remote-Groups {http.reverse_proxy.header.Remote-Groups}
			request_header Remote-Roles {http.reverse_proxy.header.Remote-Roles}
		}
	}
}

# A person who holds a role in an app. Args: app, role, upstream, e.g.
#   import role "enquiries" "admin" fellows:8080
# The app and role must be declared in the gateway's app roles manifest, or
# every request is refused. The guard deletes the client's copies of every
# identity and rule header first, Remote-Roles and the role headers included,
# so the app sees only the gateway's answer.
(role) {
	route {
		import strip_client_identity
		request_header -Remote-Roles
		request_header -X-Auth-App
		request_header -X-Auth-Role
		import auth_gate_role "{args[0]}" "{args[1]}"
		reverse_proxy {args[2]} {
			import strip_auth_cookie
		}
	}
}

# Strip the shared session cookie before the request reaches an app backend. The
# session cookie is scoped to .<domain>, so the browser sends it to every
# subdomain, and forward_auth proxies the original request (cookies included)
# upstream. Without this strip, every protected app backend would receive a live,
# estate-wide bearer credential it doesn't need, and a single compromised or
# malicious app could replay it against every other app as that user (there is no
# per-session revocation to stop it). Apps must take identity ONLY from the
# Remote-* headers -- which forward_auth sets and Caddy strips from client input
# -- never from the cookie. The guards above import this automatically; it is
# also exposed for a hand-rolled reverse_proxy. It removes only vps_auth_session,
# leaving the app's own cookies intact.
(strip_auth_cookie) {
	header_up Cookie "(^|;\s*)vps_auth_session=[^;]*" ""
}

# For a PUBLIC route: import inside its reverse_proxy, in place of
# strip_auth_cookie. A public route has no guard, so nothing else removes the
# identity headers a client sends, and an app that reads Remote-User anywhere
# (a mixed host whose webhook path shares the app's middleware) would believe a
# forged identity there. This removes the session cookie and every Remote-*
# header. Never use it inside a guard: there the Remote-* headers are the
# gateway's own and must reach the app. Proven by e2e/chain_test.go.
(strip_public) {
	header_up Cookie "(^|;\s*)vps_auth_session=[^;]*" ""
	header_up -Remote-User
	header_up -Remote-Email
	header_up -Remote-Groups
	header_up -Remote-Roles
}

# Delete any client-supplied identity headers from the request BEFORE forward_auth
# runs, so its copy_headers can re-add the authoritative values on a 2xx. The apps
# trust Remote-* because only Caddy sets them; this makes that guarantee explicit
# rather than relying solely on copy_headers' overwrite-on-2xx (which leaves a
# theoretical gap on non-2xx and is easy to misread). It MUST be imported inside a
# route {} (as the guards above do) so it runs before forward_auth: Caddy's default
# directive order otherwise places a bare request_header AFTER forward_auth, which
# would delete the authoritative value instead. Verified against Caddy 2 with a
# live forward_auth + whoami harness.
(strip_client_identity) {
	request_header -Remote-User
	request_header -Remote-Email
	request_header -Remote-Groups
	# Every guard strips a client-sent Remote-Roles too, not only the role
	# guard: an app that reads Remote-Roles must never believe one a client
	# sent through an older guard.
	request_header -Remote-Roles
}

# The login site. No auth in front of this — it IS the login. Overwrite
# X-Forwarded-For with the true peer so a client can't spoof the rate-limit key
# (Caddy otherwise preserves inbound X-Forwarded-For). Caddy faces clients
# directly here, so {remote_host} is the real client.
auth.{$DOMAIN} {
	reverse_proxy auth:8080 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# A protected demo app. Visit https://app.{$DOMAIN}: you'll be redirected to the
# login, and after signing in you'll see the Remote-* identity headers echoed.
# The session cookie is stripped before whoami sees it (folded into the guard).
app.{$DOMAIN} {
	import role "demo" "user" whoami:80
}
